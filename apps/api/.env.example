# ============================================================
# .env.example — modelo das variáveis de ambiente da API
#
# Como usar: copie este arquivo para ".env" (na mesma pasta)
# e troque os valores. O .env real NUNCA vai pro git.
# ============================================================

# Usadas pelo docker-compose para criar o banco na primeira vez
POSTGRES_USER=crm
POSTGRES_PASSWORD=troque_essa_senha
POSTGRES_DB=crm

# Usada pela API (dotenvy) e pelo sqlx-cli para conectar no banco
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
# A porta 5433 é a do docker-compose (5432 costuma estar ocupada por um Postgres local)
DATABASE_URL=postgres://crm:troque_essa_senha@localhost:5433/crm
